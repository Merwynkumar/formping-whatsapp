# =============================================================================
# FormPing WhatsApp: environment variables
# Copy to web/.env.local for local dev, and add each one to the dedicated
# `formping-whatsapp` Vercel project (vercel env add NAME production).
# None of these are shared with any other app. Never commit real values.
# =============================================================================

# --- Shared secret between the Apps Script add-on and this backend ----------
# Generate: openssl rand -hex 32
# Put the SAME value in Apps Script > Project Settings > Script Properties.
FORMPING_API_SECRET=

# Verify the caller's Google identity (ScriptApp.getOAuthToken) matches
# user_email. Keep true in production; false only for local curl testing.
FORMPING_VERIFY_GOOGLE_TOKEN=true
# Optional: pin tokens to the add-on's GCP OAuth client ID.
GOOGLE_OAUTH_CLIENT_ID=

# --- Supabase (NEW dedicated project, server-side only) ----------------------
SUPABASE_URL=https://YOUR-FORMPING-PROJECT-REF.supabase.co
# Settings > API Keys > service_role / secret key. Server only, never public.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Business Cloud API (single master account) ---------------
# System user permanent token with whatsapp_business_messaging permission.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0
# Approved UTILITY templates (see README). Param counts must match the template.
META_TEMPLATE_OWNER=formping_owner_alert
META_TEMPLATE_OWNER_PARAMS=2
META_TEMPLATE_CUSTOMER=formping_auto_reply
META_TEMPLATE_CUSTOMER_PARAMS=3
META_TEMPLATE_LANGUAGE=en

# --- Razorpay (subscriptions) ------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Plan ids from the plan-creation step in the README.
RAZORPAY_PLAN_ID_USD=
RAZORPAY_PLAN_ID_INR=
# Monthly cycles before the subscription ends (Razorpay requires a number).
RAZORPAY_TOTAL_COUNT=120

# --- Public site (compliance pages) ------------------------------------------
NEXT_PUBLIC_SITE_URL=https://formping-whatsapp.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@formping.app
NEXT_PUBLIC_COMPANY_NAME=FormPing
